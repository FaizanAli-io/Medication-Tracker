// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  medications Medication[]
  logs        MedicationLog[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  
  medications MedicationCategory[]
}

model Medication {
  id          String   @id @default(uuid())
  name        String
  description String?
  dosage      String
  pattern     String   // "once-daily", "1+0+1", "1+1+1", "1+1+1+1"
  duration    Int      // in days
  startDate   DateTime
  endDate     DateTime
  timing      String   // JSON string with timing details
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories MedicationCategory[]
  logs       MedicationLog[]
  schedules  DoseSchedule[]
}

model MedicationCategory {
  medicationId String
  categoryId   String
  
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([medicationId, categoryId])
}

model DoseSchedule {
  id           String    @id @default(uuid())
  medicationId String
  scheduledAt  DateTime
  doseType     String    // "morning", "afternoon", "evening", "night"
  taken        Boolean   @default(false)
  takenAt      DateTime?
  skipped      Boolean   @default(false)
  rescheduled  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
}

model MedicationLog {
  id           String   @id @default(uuid())
  medicationId String
  userId       String
  action       String   // "taken", "missed", "rescheduled", "skipped"
  scheduledAt  DateTime
  actualAt     DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}
